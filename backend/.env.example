# Copy to backend/.env for production. Leave DJANGO_DEBUG=true on your laptop.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=paste-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=fitscan.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://fitscan.example.com
DJANGO_TIME_ZONE=Europe/London
# Optional: PostgreSQL instead of SQLite
# DATABASE_URL=postgres://user:password@host:5432/fitscan
